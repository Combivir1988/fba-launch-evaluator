# Ключ Claude API — только на сервере, никогда в браузере
ANTHROPIC_API_KEY=sk-ant-...
# Общий пароль доступа к приложению (обязателен; без него сервер отвечает 503 на /api/*)
APP_PASSWORD=change-me
# Модель и глубина размышлений (по умолчанию claude-opus-5 / high)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
# 1 = серверные fallbacks при refusal (beta), 0 = выключить
CLAUDE_FALLBACKS=1
# 1 = не ходить в Claude, отдавать демонстрационный вердикт
MOCK_AI=0
PORT=3000
RATE_LIMIT_PER_HOUR=20
