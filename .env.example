# Провайдер AI: openrouter (по умолчанию, если задан OPENROUTER_API_KEY) или anthropic
AI_PROVIDER=openrouter
# OpenRouter: один ключ — много моделей (openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-...
# Модель по умолчанию и список для выбора в интерфейсе (через запятую)
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_MODELS=google/gemini-3.8-flash,openai/gpt-5.6-sol,anthropic/claude-sonnet-5,anthropic/claude-opus-5,deepseek/deepseek-v3.2,x-ai/grok-4.6,deepseek/deepseek-v4-flash-0731:free,nvidia/nemotron-3-super-120b-a12b:free
# 1 = просить у модели reasoning (если поддерживает); 0 = без
OPENROUTER_REASONING=0
# Ключ Claude API напрямую (нужен только при AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Хранилище: строка подключения Postgres (Neon, pooled-хост). В production обязательна; локально без неё поднимается PGlite в .data/pg
# В env-файлах для bash значение берите в одинарные кавычки — в строке есть символ &
DATABASE_URL=
# Первый администратор: создаётся при старте, только если в БД нет активного администратора (он же — способ восстановить доступ)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-min-10-chars
# Общий предел одновременных AI-задач
MAX_JOBS=4
# APP_PASSWORD больше не используется (spec 002: личные учётные записи)
# Модель и глубина размышлений (по умолчанию claude-opus-5 / high)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
# 1 = серверные fallbacks при refusal (beta), 0 = выключить
CLAUDE_FALLBACKS=1
# 1 = не ходить в Claude, отдавать демонстрационный вердикт
MOCK_AI=0
PORT=3000
RATE_LIMIT_PER_HOUR=20
